# Copy to .env on the server (next to compose.yml). .env is never committed.

# Image: your registry path and the tag to run (a git SHA from docker-build.sh).
SABACC_IMAGE=registry.example.com/you/sabacc
SABACC_TAG=latest

# Public host name Traefik routes to this container.
SABACC_HOST=sabacc.example.com

# Your Traefik setup (defaults shown).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Game timers, in seconds (defaults shown).
TURN_SECONDS=45
GRACE_SECONDS=30
AUTO_DEAL_SECONDS=20
